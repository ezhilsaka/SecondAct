NEXT_PUBLIC_APP_NAME=Second Act
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=report-pdfs

# Supabase Postgres
DATABASE_URL=
# Direct Postgres connection. Requires an IPv6-capable environment or the Supabase IPv4 add-on.
# Do not rely on this from Vercel or other current IPv4-only environments.
DIRECT_URL=

# Queue worker
GRAPHILE_WORKER_SCHEMA=graphile_worker
GRAPHILE_WORKER_CONCURRENCY=1
GRAPHILE_WORKER_POLL_INTERVAL_MS=1000
REPORT_RUN_TASK_IDENTIFIER=report.run.generate

# Narrative provider (Step 8+; Gemini via OpenAI-compatible endpoint)
NARRATIVE_PROVIDER=openai-compatible
NARRATIVE_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NARRATIVE_PROVIDER_API_KEY=your-gemini-api-key
NARRATIVE_MODEL=gemini-2.5-flash
NARRATIVE_PROVIDER_TIMEOUT_MS=30000

# Python market data adapter
MARKET_DATA_SERVICE_URL=http://127.0.0.1:8000
MARKET_DATA_SERVICE_TIMEOUT_MS=10000
MARKET_DATA_ADAPTER_PROVIDER=yfinance
# Shared secret between the Python adapter and the backend caller.
MARKET_DATA_ADAPTER_INTERNAL_API_SECRET=replace-with-long-random-secret
MARKET_DATA_ADAPTER_HOST=127.0.0.1
MARKET_DATA_ADAPTER_PORT=8000
MARKET_DATA_ADAPTER_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_ADAPTER_MAX_TICKERS=50
MARKET_DATA_ADAPTER_MAX_RETRIES=1

# PDF rendering
PLAYWRIGHT_BROWSER=chromium

# Local Vercel pause/resume helpers (do not commit real values)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=
