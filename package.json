{
  "name": "second-act",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "prisma format --schema src/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema src/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema src/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema src/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema src/db/prisma/schema.prisma",
    "worker:dev": "node --import tsx src/server/queue/worker.ts",
    "playwright:install": "playwright install chromium",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "graphile-worker": "^0.16.6",
    "ky": "^1.14.3",
    "next": "^16.2.1",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
